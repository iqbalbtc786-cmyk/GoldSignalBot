# ---- Existing trading signal bot ----
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Social media auto-posting workflow ----
# Language for hooks/captions and the text drawn on the image/reel: "ur"
# (Pakistani Urdu, default) or "en". Urdu rendering uses a bundled font +
# proper right-to-left shaping, no extra setup needed.
SOCIAL_LANGUAGE=ur
# Master switch: set to false to generate content without publishing anywhere.
SOCIAL_AUTOPOST_ENABLED=true
# Minimum signal confidence (%) required before the pipeline posts at all.
SOCIAL_CONFIDENCE_THRESHOLD=70
# Also render/post a reel for NEUTRAL "no trade" market updates.
POST_REEL_ON_NEUTRAL=false
SOCIAL_DISCLAIMER="Not financial advice. Trading involves risk — always use proper risk management."

# Branding shown on the generated image/reel
BRAND_NAME="Gold Signal Pro"
BRAND_HANDLE="@goldsignalpro"
BRAND_PRIMARY_COLOR=#0B0F1A
BRAND_GOLD_COLOR=#D4AF37

# Optional: use an LLM to write fresh hooks instead of the built-in hook bank
OPENAI_API_KEY=
OPENAI_HOOK_MODEL=gpt-4o-mini

# Telegram — reuses TELEGRAM_TOKEN above. Set this if your public/social
# channel is different from the private alert chat (TELEGRAM_CHAT_ID).
TELEGRAM_SOCIAL_CHANNEL_ID=

# Facebook Page (Graph API) — direct file upload, no public hosting needed.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Business/Creator account (Graph API Content Publishing).
# Instagram REQUIRES a public URL for the media, so deploy via app.py
# (see README > Deployment). On Render, MEDIA_PUBLIC_BASE_URL is
# auto-detected from RENDER_EXTERNAL_URL — leave it blank there.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
MEDIA_PUBLIC_BASE_URL=

# Twitter / X (developer app with read+write access)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Optional background music track for the reel (local file path)
REEL_MUSIC_PATH=
